{
  "name": "barely-css",
  "version": "0.0.0",
  "description": "A classless, token-driven CSS baseline for semantic HTML.",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "style": "dist/barely.css",
  "exports": {
    ".": "./dist/barely.css",
    "./barely.css": "./dist/barely.css",
    "./barely.min.css": "./dist/barely.min.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narcisolobo/barely-css.git"
  },
  "homepage": "https://github.com/narcisolobo/barely-css#readme",
  "bugs": {
    "url": "https://github.com/narcisolobo/barely-css/issues"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check:dist": "node scripts/build.js --check",
    "test": "playwright test",
    "visual": "playwright test -c tests/visual/visual.config.js"
  },
  "keywords": [
    "css",
    "classless",
    "semantic-html",
    "design-tokens"
  ],
  "author": "Narciso Lobo",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  }
}
